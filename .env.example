# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model used by the agent. Opus 5 is the default; claude-sonnet-5 is cheaper
# and adequate once the tool layer is doing the real work.
ANTHROPIC_MODEL=claude-opus-5

# Where the DuckDB database is built. Gitignored — regenerate with
# `uv run python -m football_agent.data.build`.
DUCKDB_PATH=football.duckdb
